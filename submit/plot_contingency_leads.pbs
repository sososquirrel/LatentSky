#!/bin/bash -l
#PBS -N plot_cont_leads
#PBS -A UNYU0027
#PBS -q casper
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=4:mem=64GB:ngpus=1
#PBS -j oe
#PBS -k eod

# Side-by-side contingency comparison (mseuv / humid / mse) at leads 0h, 1h, 2h.

export TMPDIR=${SCRATCH}/temp
mkdir -p "$TMPDIR"

eval "$(conda shell.bash hook)"
conda activate /glade/work/${USER}/conda-envs/latentsky-env

cd /glade/u/home/${USER}/LatentSky
export PYTHONPATH=/glade/u/home/${USER}/LatentSky:${PYTHONPATH}

python -u scripts/plotting/plot_contingency_compare_leads.py --leads 0 1 2
