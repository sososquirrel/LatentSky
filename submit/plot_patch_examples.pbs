#!/bin/bash -l
#PBS -N patch_examples
#PBS -A UCLB0066
#PBS -q develop
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=4:mem=32GB:ngpus=1:gpu_type=a100
#PBS -j oe
#PBS -k eod

# Generate the per-patch truth/pred/segmentation/matching illustration
# gallery. Needs a GPU for inference (calls predict_piece on multiple runs).

export TMPDIR=${SCRATCH}/temp
mkdir -p "$TMPDIR"

ENV_PY=/glade/work/${USER}/conda-envs/latentsky-env/bin/python

cd /glade/u/home/${USER}/LatentSky
export PYTHONPATH=/glade/u/home/${USER}/LatentSky:${PYTHONPATH}

$ENV_PY -u scripts/plotting/plot_patch_examples.py \
    --max-examples ${MAX_EXAMPLES:-24} \
    --keep-frames ${KEEP_FRAMES:-24}
