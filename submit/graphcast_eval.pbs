#!/bin/bash -l
#PBS -N graphcast_eval
#PBS -A UCLB0066
#PBS -q develop
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=16:mem=64GB
#PBS -j oe
#PBS -k eod

# End-to-end GraphCast evaluation:
#   1. fetch GraphCast (lead=6h) + ERA5 truth from WeatherBench2 for the
#      requested month, tropical crop, into local NetCDF cache
#   2. run scripts/eval_graphcast_scale.py (uses our scale_analysis pipeline)
#   3. run scripts/plot_scale_decomposition.py to produce the 6-panel figure
#      in the same format as scale_decomp_mseuv_lead3h_v2.png
#
# Notes:
#  * No GPU needed — eval is pure numpy/scipy on (T, H, W) precip fields.
#  * MONTH defaults to 2020-08, GraphCast's canonical test period.
#  * Dask uses 16 workers (--ncpus) to parallelize the GCS chunk reads.

export TMPDIR=${SCRATCH}/temp
mkdir -p "$TMPDIR"

ENV_PY=/glade/work/${USER}/conda-envs/latentsky-env/bin/python
MONTH=${MONTH:-2020-08}

cd /glade/u/home/${USER}/LatentSky
export PYTHONPATH=/glade/u/home/${USER}/LatentSky:${PYTHONPATH}

echo "=== 1. Fetch GraphCast + ERA5 for ${MONTH} ==="
$ENV_PY -u scripts/fetch_graphcast_era5.py --month "$MONTH" 2>&1 \
    | grep -vE "Could not determine|FutureWarning"

echo
echo "=== 2. Run scale-aware eval ==="
$ENV_PY -u scripts/eval_graphcast_scale.py --month "$MONTH" \
    --threshold ${THRESHOLD:-0.1} \
    --scale-min ${SCALE_MIN:-25} \
    --scale-max ${SCALE_MAX:-600} \
    --scale-bins ${SCALE_BINS:-10}

echo
echo "=== 3. Plot 6-panel scale decomposition figure ==="
NAME="graphcast_${MONTH}_6h"
$ENV_PY -u scripts/plot_scale_decomposition.py \
    --systems "docs/scale_systems_graphcast_${MONTH}.csv.gz" \
    --summary "docs/scale_summary_graphcast_${MONTH}.csv" \
    --run "$NAME" \
    --out "docs/figures/scale_decomp_${NAME}.png"

echo
echo "=== Done ==="
ls -la docs/figures/scale_decomp_${NAME}.png \
       docs/scale_systems_graphcast_${MONTH}.csv.gz \
       docs/scale_summary_graphcast_${MONTH}.csv
