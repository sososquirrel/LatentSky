#!/bin/bash -l
#PBS -N plot_figs
#PBS -A UNYU0027
#PBS -q casper
#PBS -l walltime=01:00:00
#PBS -l select=1:ncpus=4:mem=64GB:ngpus=1
#PBS -j oe
#PBS -k eod

# Generate the qualitative maps (notebook 02) and contingency plots (notebook 03).
# Notebook 01 is a CSV plot and runs fine on the login node, so it isn't here.

export TMPDIR=${SCRATCH}/temp
mkdir -p "$TMPDIR"

eval "$(conda shell.bash hook)"
conda activate /glade/work/${USER}/conda-envs/latentsky-env

cd /glade/u/home/${USER}/LatentSky
export PYTHONPATH=/glade/u/home/${USER}/LatentSky:${PYTHONPATH}

python -u scripts/plot_qualitative_maps.py
python -u scripts/plot_contingency.py
