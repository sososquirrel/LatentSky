#!/bin/bash -l
#PBS -N wb2_illust_2p4
#PBS -A UCLB0066
#PBS -q develop
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=4:mem=32GB
#PBS -j oe
#PBS -k eod

export TMPDIR=${SCRATCH}/temp
mkdir -p "$TMPDIR"

ENV_PY=/glade/work/${USER}/conda-envs/latentsky-env/bin/python
REPO=/glade/u/home/${USER}/LatentSky

cd "$REPO"
export PYTHONPATH="$REPO:${PYTHONPATH}"

FILTER='Could not determine|FutureWarning|frozen _collections'

echo "=== WB2 illustration at 2.4 mm/6h (= 0.1 mm/15min x 24 steps) ==="
$ENV_PY -u scripts/plot_wb2_illustration.py \
    --threshold 2.4 \
    --iou-min 0.1 \
    2>&1 | grep -vE "$FILTER"

echo "=== Done ==="
ls -lh docs/figures/wb2_illustration_2020-08-15_thr2p4.png 2>/dev/null
