#!/bin/bash -l
#PBS -N eval_scale_rain_resid6h
#PBS -A UCLB0066
#PBS -q develop
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=8:mem=64GB:ngpus=1:gpu_type=a100
#PBS -j oe
#PBS -k eod

# Scale-aware object decomposition for the residual-target lead6h run only —
# this is the one that catastrophically failed (giant false-alarm blobs) in
# the direct-target sweep. Fastest, most informative check of whether
# residual/persistence-anchored training fixes it.

export TMPDIR=${SCRATCH}/temp
mkdir -p "$TMPDIR"

ENV_PY=/glade/work/${USER}/conda-envs/latentsky-env/bin/python

_NV=/glade/work/${USER}/conda-envs/latentsky-env/lib/python3.11/site-packages/nvidia
export LD_LIBRARY_PATH=\
${_NV}/cublas/lib:${_NV}/cuda_cupti/lib:${_NV}/cuda_nvrtc/lib:\
${_NV}/cuda_runtime/lib:${_NV}/cudnn/lib:${_NV}/cufft/lib:\
${_NV}/curand/lib:${_NV}/cusolver/lib:${_NV}/cusparse/lib:\
${_NV}/cusparselt/lib:${_NV}/nccl/lib:${_NV}/nvjitlink/lib:\
${_NV}/nvtx/lib:${LD_LIBRARY_PATH:-}

cd /glade/u/home/${USER}/LatentSky
export PYTHONPATH=/glade/u/home/${USER}/LatentSky:${PYTHONPATH}

$ENV_PY -u scripts/eval_scale_decomposition.py \
    --systems-out docs/scale_systems_rain_resid_lead6h.csv.gz \
    --summary-out docs/scale_summary_rain_resid_lead6h.csv \
    --max-frames-per-piece 8 \
    --threshold 0.1 \
    --scale-min 25 \
    --scale-max 3000 \
    --scale-bins 8 \
    --runs "mseuv_rain_resid_lead6h"
