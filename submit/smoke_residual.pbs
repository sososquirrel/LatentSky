#!/bin/bash -l
#PBS -N smoke_residual
#PBS -A UCLB0066
#PBS -q develop
#PBS -l walltime=00:15:00
#PBS -l select=1:ncpus=4:mem=32GB:ngpus=1:gpu_type=a100
#PBS -j oe
#PBS -k eod

export TMPDIR=${SCRATCH}/temp
mkdir -p "$TMPDIR"

ENV_PY=/glade/work/${USER}/conda-envs/latentsky-env/bin/python

_NV=/glade/work/${USER}/conda-envs/latentsky-env/lib/python3.11/site-packages/nvidia
export LD_LIBRARY_PATH=\
${_NV}/cublas/lib:${_NV}/cuda_cupti/lib:${_NV}/cuda_nvrtc/lib:\
${_NV}/cuda_runtime/lib:${_NV}/cudnn/lib:${_NV}/cufft/lib:\
${_NV}/curand/lib:${_NV}/cusolver/lib:${_NV}/cusparse/lib:\
${_NV}/cusparselt/lib:${_NV}/nccl/lib:${_NV}/nvjitlink/lib:\
${_NV}/nvtx/lib:${LD_LIBRARY_PATH:-}

cd /glade/u/home/${USER}/LatentSky
export PYTHONPATH=/glade/u/home/${USER}/LatentSky:${PYTHONPATH}

$ENV_PY -u -c "
import numpy as np, torch
from latentsky.data import load_piece_arrays
from latentsky.train import _load_xy, _split_target
from latentsky.config import ExperimentConfig
from latentsky.models import UNet2D

pieces_dir = '/glade/derecho/scratch/sabramian/latentsky_pieces'
input_vars = ['precipw','t2m','olrtoa','mse_500hPa','mse_850hPa','uzonal_500hPa',
              'uzonal_850hPa','umeridional_500hPa','umeridional_850hPa','rain_log1p']

cfg = ExperimentConfig(name='smoke', input_vars=input_vars, lead_steps_15=1,
                        target_prefix='rain_total', residual=True,
                        out_activation='identity', pieces_dir=pieces_dir)
print('delta_index:', cfg.delta_index, flush=True)

print('=== 1. load_piece_arrays with return_persisted, n_frames=4 ===', flush=True)
X, Y, P = load_piece_arrays(pieces_dir, 2, input_vars, 'rain_total', cfg.delta_index,
                             n_frames=4, return_persisted=True)
print('X', X.shape, 'Y', Y.shape, 'P', P.shape, flush=True)
print('Y range', Y.min(), Y.max(), flush=True)
print('P range', P.min(), P.max(), flush=True)
resid = Y - P
print('resid range', resid.min(), resid.max(), flush=True)
assert X.shape[0] == Y.shape[0] == P.shape[0] == 4
assert Y.shape[1] == P.shape[1] == 1

print('=== 2. _load_xy (train-time helper), full piece ===', flush=True)
Xt, Yt = _load_xy(cfg, 2)
print('Xt', Xt.shape, 'Yt (2ch: resid,mask)', Yt.shape, flush=True)
assert Yt.shape[1] == 2
mask_frac = Yt[:, 1].mean()
print('mask channel mean (frac wet-or-persisted):', mask_frac, flush=True)
assert 0 < mask_frac < 1
y_target, m = _split_target(torch.from_numpy(Yt[:4]), True)
print('y_target', y_target.shape, 'mask', m.shape, m.dtype, 'mask sum', m.sum().item(), flush=True)
assert y_target.shape[1] == 1 and m.shape[1] == 1

print('=== 3. forward pass through UNet2D with identity activation ===', flush=True)
model = UNet2D(in_ch=len(input_vars), out_ch=1, base_ch=16, depth=2,
               out_activation=cfg.out_activation)
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
model = model.to(device)
xb = torch.from_numpy(Xt[:2, :, :128, :128]).to(device)
out = model(xb)
print('model output shape', out.shape, 'min', out.min().item(), 'max', out.max().item(), flush=True)
assert out.min().item() < 0 or out.max().item() > 0  # identity: no positivity clamp
print('identity activation confirmed unclamped (softplus would force >=0)', flush=True)

print('=== 4. inference reconstruction (predict_piece-style) ===', flush=True)
from latentsky.inference import _infer
Xp, Yp_true, Pp = load_piece_arrays(pieces_dir, 2, input_vars, 'rain_total', cfg.delta_index,
                                     n_frames=4, return_persisted=True)
Y_pred_resid = _infer(model, Xp, Yp_true, batch_size=1, device=device)
Y_pred_raw = np.clip(Y_pred_resid + Pp, a_min=0.0, a_max=None)
print('Y_pred_raw shape', Y_pred_raw.shape, 'min', Y_pred_raw.min(), 'max', Y_pred_raw.max(), flush=True)
assert Y_pred_raw.min() >= 0.0
print('reconstruction non-negative: OK', flush=True)

print('ALL SMOKE TESTS PASSED', flush=True)
"
