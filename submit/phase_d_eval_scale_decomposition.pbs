#!/bin/bash
#PBS -N ls_phase_d_scaledecomp
#PBS -A UCLB0066
#PBS -q develop
#PBS -l walltime=02:30:00
#PBS -l select=1:ncpus=8:mem=64GB:ngpus=1:gpu_type=a100
#PBS -j oe
#PBS -o /glade/derecho/scratch/sabramian/logs/ls_phase_d_scaledecomp.log

set -euo pipefail

export TMPDIR=/glade/derecho/scratch/sabramian/tmp
export LATENTSKY_RUNS_DIR=/glade/derecho/scratch/sabramian/LatentSky_runs
mkdir -p "$TMPDIR"
export PYTHONPATH="/glade/u/home/sabramian/LatentSky:${PYTHONPATH:-}"

_NV=/glade/work/sabramian/conda-envs/latentsky-env/lib/python3.11/site-packages/nvidia
export LD_LIBRARY_PATH=\
${_NV}/cublas/lib:${_NV}/cuda_cupti/lib:${_NV}/cuda_nvrtc/lib:\
${_NV}/cuda_runtime/lib:${_NV}/cudnn/lib:${_NV}/cufft/lib:\
${_NV}/curand/lib:${_NV}/cusolver/lib:${_NV}/cusparse/lib:\
${_NV}/cusparselt/lib:${_NV}/nccl/lib:${_NV}/nvjitlink/lib:\
${_NV}/nvtx/lib:${LD_LIBRARY_PATH:-}

cd /glade/u/home/sabramian/LatentSky
ENV_PY=/glade/work/sabramian/conda-envs/latentsky-env/bin/python

$ENV_PY -u scripts/analysis/eval_scale_decomposition.py \
    --runs mseuv_rain_resid_lead3h,mseuv_rain_resid_lead6h,patchsplit_twohead_olr_fss_lead0.25h,patchsplit_twohead_olr_fss_lead0.5h,patchsplit_twohead_olr_fss_lead1h,patchsplit_twohead_olr_fss_lead2h,patchsplit_twohead_olr_fss_lead3h,patchsplit_twohead_olr_fss_lead6h \
    --max-frames-per-piece 16 \
    --systems-out docs/scale_systems_modelcompare.csv.gz \
    --summary-out docs/scale_summary_modelcompare.csv

echo "=== DONE ==="
