#!/bin/bash
#PBS -N ls_onehead_3h
#PBS -A UCLB0066
#PBS -q main
#PBS -l select=1:ncpus=8:mem=128GB:ngpus=1:gpu_type=a100
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /glade/derecho/scratch/sabramian/logs/ls_onehead_3h.log

# Missing architecture-only control for patchsplit_twohead_olr_fss_lead3h:
# identical input_vars/patch-split settings/hyperparameters, two_head=false
# (plain masked-MSE loss) -- isolates the two-head+OLR-FiLM+FSS effect from
# the split/inputs/schedule, which are otherwise identical.

set -euo pipefail

CONFIG=configs/patchsplit_onehead_lead3h.yaml

export TMPDIR=/glade/derecho/scratch/sabramian/tmp
export LATENTSKY_RUNS_DIR=/glade/derecho/scratch/sabramian/LatentSky_runs
mkdir -p "$TMPDIR"
export PYTHONPATH="/glade/u/home/sabramian/LatentSky:${PYTHONPATH:-}"

_NV=/glade/work/sabramian/conda-envs/latentsky-env/lib/python3.11/site-packages/nvidia
export LD_LIBRARY_PATH=\
${_NV}/cublas/lib:${_NV}/cuda_cupti/lib:${_NV}/cuda_nvrtc/lib:\
${_NV}/cuda_runtime/lib:${_NV}/cudnn/lib:${_NV}/cufft/lib:\
${_NV}/curand/lib:${_NV}/cusolver/lib:${_NV}/cusparse/lib:\
${_NV}/cusparselt/lib:${_NV}/nccl/lib:${_NV}/nvjitlink/lib:\
${_NV}/nvtx/lib:${LD_LIBRARY_PATH:-}

cd /glade/u/home/sabramian/LatentSky

ENV_PY=/glade/work/sabramian/conda-envs/latentsky-env/bin/python
echo "=== ${CONFIG} ==="
$ENV_PY -m latentsky.train --config "$CONFIG"
