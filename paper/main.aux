\@writefile{toc}{\contentsline {paragraph}{Trigger vs amplitude: two regimes.}{8}{section*.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Predictive-information decay vs lead, by scale and component. (a) Detection skill (POD) and (b) intensity skill (correlation of $\ln \rho $ for matched systems), with exponential fits (Eq.~\ref {eq:efold}). The all-scale trigger curve tracks the small-scale curve because POD is count-weighted and small cells dominate the system population; the all-scale amplitude curve tracks the large-scale curve because the matched pool (on which intensity is evaluated) is dominated by the large systems that are successfully detected. Trigger skill for small systems ($T_e^{\text  {det}}\!=\!0.73$\,h) is a factor of twelve shorter than for large systems ($T_e^{\text  {det}}\!=\!8.8$\,h). Amplitude of large systems persists well beyond 6\,h ($T_e^{\text  {int}}\!\approx \!21$\,h), while small-system amplitude fades at a similar rate to the trigger ($T_e^{\text  {int}}\!=\!0.91$\,h).}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:horizon}{{5}{9}{Predictive-information decay vs lead, by scale and component. (a) Detection skill (POD) and (b) intensity skill (correlation of $\ln \rho $ for matched systems), with exponential fits (Eq.~\ref {eq:efold}). The all-scale trigger curve tracks the small-scale curve because POD is count-weighted and small cells dominate the system population; the all-scale amplitude curve tracks the large-scale curve because the matched pool (on which intensity is evaluated) is dominated by the large systems that are successfully detected. Trigger skill for small systems ($T_e^{\text {det}}\!=\!0.73$\,h) is a factor of twelve shorter than for large systems ($T_e^{\text {det}}\!=\!8.8$\,h). Amplitude of large systems persists well beyond 6\,h ($T_e^{\text {int}}\!\approx \!21$\,h), while small-system amplitude fades at a similar rate to the trigger ($T_e^{\text {int}}\!=\!0.91$\,h)}{figure.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Fitted predictability parameters (Eq.~\ref {eq:efold}): zero-lead skill $S_0$, $e$-folding time $T_e$, and climatological floor $S_\infty $. Large-system intensity $T_e$ exceeds the $6$\,h window and is poorly constrained (denoted $\gg 6$).}}{9}{table.caption.12}\protected@file@percent }
\newlabel{tab:Te}{{1}{9}{Fitted predictability parameters (Eq.~\ref {eq:efold}): zero-lead skill $S_0$, $e$-folding time $T_e$, and climatological floor $S_\infty $. Large-system intensity $T_e$ exceeds the $6$\,h window and is poorly constrained (denoted $\gg 6$)}{table.caption.12}{}}
