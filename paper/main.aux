\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Rain-rate contingency (log counts) between truth ($y$) and prediction ($x$) at lead $0$\,h (top) and $1$\,h (bottom) for three input configurations (\textsf  {9var}: MSE + winds; \textsf  {5var-mse}: MSE only; \textsf  {5var-relhum}: relative humidity only). Mass below the diagonal indicates intensity under-prediction. Adding winds substantially reduces false alarms and improves intensity estimation at zero lead.}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:confusion}{{3}{7}{Rain-rate contingency (log counts) between truth ($y$) and prediction ($x$) at lead $0$\,h (top) and $1$\,h (bottom) for three input configurations (\textsf {9var}: MSE + winds; \textsf {5var-mse}: MSE only; \textsf {5var-relhum}: relative humidity only). Mass below the diagonal indicates intensity under-prediction. Adding winds substantially reduces false alarms and improves intensity estimation at zero lead}{figure.caption.9}{}}
