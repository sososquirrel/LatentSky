\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces POD (a) and FAR (b) vs system scale at $6$\,h lead for our model (MPAS truth) and GraphCast (ERA5 truth), at a rate-matched detection threshold ($0.4$\,mm\,h$^{-1}$). Both show the monotonic scale-dependent detection collapse. Absolute levels differ because of the different truths and accumulation windows; the robust quantity is the shape of the curve.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:graphcast}{{6}{10}{POD (a) and FAR (b) vs system scale at $6$\,h lead for our model (MPAS truth) and GraphCast (ERA5 truth), at a rate-matched detection threshold ($0.4$\,mm\,h$^{-1}$). Both show the monotonic scale-dependent detection collapse. Absolute levels differ because of the different truths and accumulation windows; the robust quantity is the shape of the curve}{figure.caption.13}{}}
