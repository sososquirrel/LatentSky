#!/bin/bash -l
#PBS -N ls_regfields_spec
#PBS -A UCLB0066
#PBS -q casper
#PBS -l select=1:ncpus=4:mem=64GB:ngpus=1:gpu_type=a100
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -k eod

# Regression (onehead) and two-head full-field dumps for pieces 00-07
# across all 6 leads, matching the piece_ids already used by the diffusion
# power-spectrum figure (figures/main/power_spectrum_diffusion_vs_truth.png)
# -- lets that figure overlay regression/two-head spectra alongside truth
# and diffusion. Cheap: a single regression forward pass per frame, not
# iterative diffusion sampling, so this should take minutes not hours.

export TMPDIR=${SCRATCH}/tmp
mkdir -p "$TMPDIR"

eval "$(conda shell.bash hook)"
conda activate /glade/work/${USER}/conda-envs/latentsky-env

_NV=/glade/work/${USER}/conda-envs/latentsky-env/lib/python3.11/site-packages/nvidia
export LD_LIBRARY_PATH=${_NV}/cublas/lib:${_NV}/cuda_cupti/lib:${_NV}/cuda_nvrtc/lib:${_NV}/cuda_runtime/lib:${_NV}/cudnn/lib:${_NV}/cufft/lib:${_NV}/curand/lib:${_NV}/cusolver/lib:${_NV}/cusparse/lib:${_NV}/cusparselt/lib:${_NV}/nccl/lib:${_NV}/nvjitlink/lib:${_NV}/nvtx/lib:${LD_LIBRARY_PATH:-}

cd /glade/u/home/${USER}/LatentSky
export PYTHONPATH=/glade/u/home/${USER}/LatentSky:${PYTHONPATH}

python -u scripts/analysis/save_regression_fields_for_spectrum.py \
  --run-template 'patchsplit_onehead_lead{lead}h' \
  --tag onehead

python -u scripts/analysis/save_regression_fields_for_spectrum.py \
  --run-template 'patchsplit_twohead_olr_fss_lead{lead}h' \
  --tag two_head
