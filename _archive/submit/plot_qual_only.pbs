# Re-generate qualitative maps (notebook 02) only — uses the updated
# plot_regional_view with cmocean rain colormap + log scale + diff saturated at +/-3.

export TMPDIR=${SCRATCH}/temp
mkdir -p "$TMPDIR"

eval "$(conda shell.bash hook)"
conda activate /glade/work/${USER}/conda-envs/latentsky-env

cd /glade/u/home/${USER}/LatentSky
export PYTHONPATH=/glade/u/home/${USER}/LatentSky:${PYTHONPATH}

python -u scripts/plotting/plot_qualitative_maps.py --run "${RUN:-mseuv_lead3h}"
