#!/bin/bash -l
#PBS -N plot_hist_leads
#PBS -A UNYU0027
#PBS -q casper
#PBS -l walltime=00:30:00
#PBS -l select=1:ncpus=4:mem=64GB:ngpus=1
#PBS -j oe
#PBS -k eod

# Log-scale truth vs pred histograms for one experiment across several leads.
# Override via env vars:
#   qsub -v PREFIX=mseuv,LEADS="0 1 2" submit/plot_histograms_leads.pbs

export TMPDIR=${SCRATCH}/temp
mkdir -p "$TMPDIR"

eval "$(conda shell.bash hook)"
conda activate /glade/work/${USER}/conda-envs/latentsky-env

cd /glade/u/home/${USER}/LatentSky
export PYTHONPATH=/glade/u/home/${USER}/LatentSky:${PYTHONPATH}

python -u scripts/plotting/plot_histograms_leads.py \
    --prefix "${PREFIX:-mseuv}" \
    --leads ${LEADS:-0 1 2}
