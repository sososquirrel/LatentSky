#!/bin/bash -l
#PBS -N eval_scale_rain
#PBS -A UCLB0066
#PBS -q develop
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=8:mem=64GB:ngpus=1:gpu_type=a100
#PBS -j oe
#PBS -k eod

# Scale-aware object decomposition for the mseuv_rain_lead* sweep only
# (rain_log1p added as an input var). --runs pins the exact run names so
# this doesn't also re-evaluate the old mseuv_lead* sweep, which shares
# the same predictor_label ("9var (mse+uv)") since predictor_label can't
# see rain_log1p as distinguishing.

export TMPDIR=${SCRATCH}/temp
mkdir -p "$TMPDIR"

ENV_PY=/glade/work/${USER}/conda-envs/latentsky-env/bin/python

# CUDA libs bundled as pip nvidia-* packages (torch 2.6.0+cu124) — without
# this, `import torch` dies with "libcusparseLt.so.0: cannot open shared
# object file".
_NV=/glade/work/${USER}/conda-envs/latentsky-env/lib/python3.11/site-packages/nvidia
export LD_LIBRARY_PATH=\
${_NV}/cublas/lib:${_NV}/cuda_cupti/lib:${_NV}/cuda_nvrtc/lib:\
${_NV}/cuda_runtime/lib:${_NV}/cudnn/lib:${_NV}/cufft/lib:\
${_NV}/curand/lib:${_NV}/cusolver/lib:${_NV}/cusparse/lib:\
${_NV}/cusparselt/lib:${_NV}/nccl/lib:${_NV}/nvjitlink/lib:\
${_NV}/nvtx/lib:${LD_LIBRARY_PATH:-}

cd /glade/u/home/${USER}/LatentSky
export PYTHONPATH=/glade/u/home/${USER}/LatentSky:${PYTHONPATH}

RUNS="mseuv_rain_lead0.25h,mseuv_rain_lead0.5h,mseuv_rain_lead1h,mseuv_rain_lead2h,mseuv_rain_lead3h,mseuv_rain_lead6h"

$ENV_PY -u scripts/analysis/eval_scale_decomposition.py \
    --systems-out docs/scale_systems_rain.csv.gz \
    --summary-out docs/scale_summary_rain.csv \
    --max-frames-per-piece 8 \
    --threshold 0.1 \
    --scale-min 25 \
    --scale-max 3000 \
    --scale-bins 8 \
    --runs "$RUNS"
